---
import Layout from "@layouts/Layout.astro";
import SectionRenderer from "@components/directus/SectionRenderer.astro";
import { fetchPageBySlug } from "@lib/directus/page";
import { languagePrefixes } from "@constants/languages";

export async function getStaticPaths() {
  return languagePrefixes.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const page = await fetchPageBySlug("home");
const sections = page?.sections ?? [];
---

<Layout>
  <div class='w-full px-4'>
    <div class='w-full max-w-[1024px] mx-auto'>
      {
        sections.map((section) => (
          <SectionRenderer section={section} lang={lang as string} />
        ))
      }
    </div>
  </div>
</Layout>
